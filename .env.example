# --- Live job sources (all optional; free public boards work without keys) ---
# JSearch on RapidAPI: aggregates LinkedIn, Indeed, Glassdoor, ZipRecruiter, Naukri via Google for Jobs.
RAPIDAPI_KEY=
# Adzuna (free key at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# in, gb, us, de, ca, au, sg, ...
ADZUNA_COUNTRY=in

# Direct scraping of LinkedIn's public job pages (against LinkedIn's terms; may be blocked)
ENABLE_LINKEDIN_SCRAPER=false
LINKEDIN_DETAIL_FETCH=15

# --- Behaviour ---
# true = only bundled sample listings
DEMO_MODE=false
# show fictional sample listings if every live source fails (keep false in production)
SAMPLE_FALLBACK=false
# hide matches scoring below this (0-100)
MIN_SCORE=30
# true = sentence-transformer matching (install requirements-ml.txt)
USE_EMBEDDINGS=false
CACHE_TTL_SECONDS=900
PROFILE_TTL_SECONDS=3600
# only needed if the frontend is hosted on another domain
CORS_ORIGINS=
